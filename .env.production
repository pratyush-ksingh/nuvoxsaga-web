# Public, non-secret build values for the production static site.
# The Turnstile SITE key is visible in every page by design; the SECRET lives only in
# Cloudflare Pages secrets (wrangler pages secret put TURNSTILE_SECRET).
NEXT_PUBLIC_SITE_URL=https://nuvoxsaga.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADFmoE20YNaWr8_w
# Display advertising (Google AdSense). 0 = no ad markup or loader is built; set to 1 only
# when the site is submitted for review, so Google's loader is live on every page.
NEXT_PUBLIC_ADS=0
# The AdSense publisher id (ca-pub-…), public by design: it appears in ads.txt and the
# page source. Empty until the AdSense-for-YouTube account is upgraded for the site.
NEXT_PUBLIC_ADSENSE_CLIENT=
