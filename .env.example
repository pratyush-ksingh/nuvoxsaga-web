# Copy to .env.local and fill in. .env.local is gitignored.
# Production values live in Vercel env vars.

# === Database ===
# Neon pooled connection string (use the pooler endpoint)
DATABASE_URI=postgresql://USER:PASS@ep-XXXX-pooler.us-east-2.aws.neon.tech/nuvoxsaga?sslmode=require

# === Payload ===
PAYLOAD_SECRET=                       # 64-byte random hex
PAYLOAD_INTERNAL_SECRET=              # 64-byte random hex (afterChange hook)

# === Auth.js v5 ===
AUTH_SECRET=                          # 64-byte random hex
AUTH_TRUST_HOST=true
# Comma-separated list of admin emails. EMPTY = sign-in fully closed (fail-safe).
# Set to your owner email(s) before deploying to production.
ADMIN_EMAIL_ALLOWLIST=admin@nuvoxsaga.com

# === Cloudflare R2 (S3-compat) ===
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nuvoxsaga-public
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# === Per-brand publisher API keys ===
# OPTIONAL on the web side — these are consumed by the Python pipeline
# via Windows Credential Manager (keyring), NOT by the website. Listed
# here as documentation only. Generated AFTER first deploy:
#   1. Sign in to /admin via magic-link
#   2. Create publisher_nuvox_<brand> users (role=publisher)
#   3. Generate API key per user → store in pipeline machine's keyring
#      via youtube-ai-system/scripts/setup_keyring.py
PUBLISHER_API_KEY_NUVOX_AI=
PUBLISHER_API_KEY_NUVOX_SPACE=
PUBLISHER_API_KEY_NUVOX_WORLD=

# === Revalidate webhook (HMAC) ===
REVALIDATE_HMAC_SECRET=                # 64-byte random hex

# === Resend ===
RESEND_API_KEY=

# === YouTube Data API v3 (referrer-restricted to *.nuvoxsaga.com) ===
YOUTUBE_API_KEY=
BRAND_NUVOX_AI_YT_CHANNEL_ID=
BRAND_NUVOX_SPACE_YT_CHANNEL_ID=
BRAND_NUVOX_WORLD_YT_CHANNEL_ID=

# === Subscriber email encryption (libsodium key) ===
SUBSCRIBER_ENCRYPTION_KEY=             # base64 32-byte key

# === Cloudflare Turnstile ===
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# === Upstash Redis (rate limit) ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Sentry ===
SENTRY_DSN=
SENTRY_AUTH_TOKEN=                     # for source map upload

# === Public ===
NEXT_PUBLIC_SITE_URL=https://nuvoxsaga.com
