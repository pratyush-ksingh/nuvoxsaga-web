# The site is a static export: it needs only public, non-secret build values.
# Production values are committed in .env.production. Copy this to .env.local to
# override them for local work (.env.local is gitignored).

# === Build (public) ===
NEXT_PUBLIC_SITE_URL=https://nuvoxsaga.com
# Cloudflare Turnstile SITE key: visible in every page by design.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# === Newsletter Pages Functions (secrets) ===
# NOT read from this file in production. Set each with:
#   npx wrangler pages secret put <NAME> --project-name nuvoxsaga
# For `wrangler pages dev`, put local values in .dev.vars (gitignored).
#
#   NEWSLETTER_HMAC_SECRET   64-byte random hex; signs confirm/unsubscribe links and keys the
#                            email fingerprint. Never rotate it: existing rows would orphan.
#   SUBSCRIBER_PUBLIC_KEY    base64 raw P-256 public key; the private key stays offline.
#   TURNSTILE_SECRET         Cloudflare Turnstile secret key.
#   RESEND_API_KEY           sends the confirmation email.
