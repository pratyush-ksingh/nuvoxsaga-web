{
  "ci": {
    "_comment": "The same thresholds as .lighthouserc.json (none loosened), pointed at a local preview built with ads on. Run once the real publisher id exists; with a placeholder id Google's loader logs errors and errors-in-console fails best-practices. Steps: NEXT_PUBLIC_ADS=1 NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-<id> npm run build:prod; npx wrangler pages dev out --port 3008; npx lhci autorun --config=.lighthouserc.ads.json --collect.url=http://localhost:3008/<desk>/news/<an eligible story>. The story URL is passed on the command line because the content set decides which story is eligible (lib/ads.ts).",
    "collect": {
      "numberOfRuns": 3,
      "url": ["http://localhost:3008/", "http://localhost:3008/ai"],
      "settings": {
        "preset": "desktop",
        "skipAudits": ["deprecations"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/news/",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
          }
        },
        {
          "matchingUrlPattern": "/",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.8 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3000 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
          }
        }
      ]
    }
  }
}
