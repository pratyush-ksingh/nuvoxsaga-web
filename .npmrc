# Phase 0 fix: Auth.js v5 (`@auth/core@0.41.2`) declares
# `@simplewebauthn/browser@^9.0.1` as a peerOptional dependency, but we use
# v13.x for our own custom WebAuthn flow (NOT Auth.js's built-in WebAuthn
# provider). The v9 peer is benign in our setup, but npm 10+ blocks the
# install with ERESOLVE. legacy-peer-deps tells npm to ignore peerDeps
# resolution conflicts and proceed.
#
# When Auth.js bumps `@auth/core` to a release with the v13 peer (or
# pnpm/yarn migration happens), this file can be removed.
legacy-peer-deps=true
