{
  "name": "nuvoxsaga-web",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "jsdom": "24.1.3",
    "html-encoding-sniffer": "3.0.0",
    "whatwg-url": "14.2.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/flatten-segment-files.mjs out && pagefind --site out --glob \"{about.html,standards.html,ai/news/**/*.html,space/news/**/*.html,world/news/**/*.html}\"",
    "lint": "eslint",
    "gen-brands": "tsx scripts/gen-brands.ts",
    "prebuild": "tsx scripts/gen-brands.ts && (git diff --exit-code lib/brands.ts app/_brand-vars.generated.css tokens/raw/brands.json || (echo \"❌ codegen drift — commit generated outputs\" && exit 1))",
    "convert-banners": "tsx scripts/convert-banners.ts",
    "typecheck": "tsc --noEmit && tsc -p functions",
    "test": "vitest",
    "e2e": "playwright test",
    "search-index": "pagefind --site out --glob \"{about.html,standards.html,ai/news/**/*.html,space/news/**/*.html,world/news/**/*.html}\"",
    "build:prod": "cross-env NEXT_PUBLIC_SITE_URL=https://nuvoxsaga.com npm run build --ignore-scripts"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@auth/pg-adapter": "^1.11.2",
    "@gsap/react": "^2.1.2",
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-s3": "^3.84.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@rive-app/react-canvas": "^4.28.2",
    "@sentry/nextjs": "^10.50.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@types/pg": "^8.20.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/og": "^0.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-type": "^22.0.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "isomorphic-dompurify": "^3.10.0",
    "lenis": "^1.3.23",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.11.0",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.31",
    "next-sitemap": "^4.2.3",
    "nodemailer": "^8.0.7",
    "payload": "^3.84.1",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "schema-dts": "^2.0.0",
    "shadcn": "^4.5.0",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.9",
    "troika-three-text": "^0.52.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@gltf-transform/cli": "^4.3.0",
    "@playwright/cli": "^0.1.21",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.0",
    "better-sqlite3": "^12.9.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.0",
    "leva": "^0.10.1",
    "pagefind": "^1.5.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
