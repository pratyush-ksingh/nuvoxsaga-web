{
  "name": "nuvoxsaga-web",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "jsdom": "24.1.3",
    "html-encoding-sniffer": "3.0.0",
    "whatwg-url": "14.2.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/flatten-segment-files.mjs out && tsx scripts/gen-ads-txt.ts out && pagefind --site out --glob \"{about.html,standards.html,ai/news/**/*.html,space/news/**/*.html,world/news/**/*.html}\"",
    "lint": "eslint",
    "gen-brands": "tsx scripts/gen-brands.ts",
    "prebuild": "tsx scripts/gen-brands.ts && (git diff --exit-code lib/brands.ts app/_brand-vars.generated.css tokens/raw/brands.json || (echo \"❌ codegen drift — commit generated outputs\" && exit 1))",
    "typecheck": "tsc --noEmit && tsc -p functions",
    "test": "vitest",
    "e2e": "playwright test",
    "search-index": "pagefind --site out --glob \"{about.html,standards.html,ai/news/**/*.html,space/news/**/*.html,world/news/**/*.html}\"",
    "build:prod": "cross-env NEXT_PUBLIC_SITE_URL=https://nuvoxsaga.com npm run build --ignore-scripts",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "isomorphic-dompurify": "^3.10.0",
    "lucide-react": "^1.11.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "schema-dts": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@playwright/cli": "^0.1.21",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^12.11.1",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.0",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
