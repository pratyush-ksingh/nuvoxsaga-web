{
  "ci": {
    "_comment": "Per-route Lighthouse thresholds, run against the deployed prod URL. The 'deprecations' audit is skipped: its only findings come from the bot-detection script Cloudflare injects on nuvoxsaga.com (/cdn-cgi/challenge-platform/scripts/jsd/main.js), which we do not ship or control; it cost ~0.19 on every page and had forced the best-practices floor down to 0.8. With it skipped the floor is back to 0.9. 'errors-in-console' stays on so a real JavaScript error still fails the check.",
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["deprecations"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/news/",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
          }
        },
        {
          "matchingUrlPattern": "/",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.8 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3000 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
          }
        }
      ]
    }
  }
}
