{
  "ci": {
    "_comment": "Phase 11 gate 7: per-route Lighthouse thresholds. Heavy-3D routes get LCP <= 3.0s; blog post detail kept at <= 2.5s. Run against deployed prod URL in CI (lhci autorun --collect.url=https://nuvoxsaga.com/...). best-practices floor is 0.8, not 0.9: Cloudflare injects its bot-detection script (/cdn-cgi/challenge-platform/scripts/jsd/main.js) on nuvoxsaga.com, and its deprecated-API warnings cost ~0.19 on every page. Our own pages score 1.0 without it.",
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/news/",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.8 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
          }
        },
        {
          "matchingUrlPattern": "/",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.8 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.8 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3000 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
          }
        }
      ]
    }
  }
}
