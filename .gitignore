# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*


# typescript
*.tsbuildinfo
next-env.d.ts

# nuvoxsaga security — secrets must never enter git
.mcp.json
.env*.local
.env
*.local
secrets/
*.key
*.pem
*.p12
*.pfx

# nuvoxsaga local artifacts
/tokens/build/
/public/splats/*.ksplat
/public/splats/*.ply
/public/3d/*.glb.bak
/playwright-report/
/test-results/

# tools / OS
Thumbs.db
.idea/
.vscode/settings.json

# Cloudflare local dev (secrets + local D1 state)
.dev.vars
.wrangler/

# local previews of real drafts (never shipped)
content-preview/
content-fixtures/

# local tooling state (never commit)
.playwright-cli/
.deploy.lock
__pycache__/

# graphify knowledge graph (regenerated locally)
graphify-out/

# Stories and story photos are written by the pipeline and backed up to the
# `content-live` branch after every deploy (youtube-ai-system/blog/static_blog.py),
# never committed on a code branch.
/content/posts/
/public/media/*
!/public/media/sections/

# IndexNow: URLs already submitted (scripts/indexnow.mjs)
/.indexnow-sent.json
